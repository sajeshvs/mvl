    "_documentation": {
        "description": "Material Code Reference Data for RFQ/PO Numbering System",
        "rfq_po_relationship": {
            "example": "RFQ-7139-V4359-1 corresponds to RFPO-7139-V4359-1",
            "format": {
                "rfq": "RFQ-{sequence}-{material_letter}{material_number}-{version}",
                "po": "RFPO-{sequence}-{material_letter}{material_number}-{order_type}",
                "co": "RFPO-{sequence}-{material_letter}{material_number}-{order_type} where order_type >= 2"
            },
            "order_type_meaning": {
                "1": "Main Order (PO)",
                "2+": "Change Order (CO)"
            }
        },
        "updated": "2026-02-12"
    },
